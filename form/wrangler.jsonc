{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 本番Worker名（https://rakutama-kintone.k-ariyama.workers.dev）に合わせる。
  // 名前を変えると別Workerとして新規デプロイされてしまうので注意。
  "name": "rakutama-kintone",
  "main": "worker.js",
  // ダッシュボード側で設定済みの環境変数（TOKEN_*等）をデプロイ時に消さない
  "keep_vars": true,
  "compatibility_date": "2026-06-26",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // IPごとの回数制限（worker.js の isRateLimited で使用）。period は 10 か 60 秒のみ指定可。
  // namespace_id はアカウント内で一意の任意の数字。
  "ratelimits": [
    { "name": "STAFF_AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "STAFF_API_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "FORM_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // 講師専用ファイル置き場。講師マニュアル（キー manual.pdf）を /api/staff/manual で認証付き配信する。
  // 差し替え: npx wrangler kv key put manual.pdf --namespace-id <id> --path <PDF> --remote（1件25MiBまで）
  "kv_namespaces": [
    { "binding": "STAFF_FILES", "id": "a3f36e39533e46e588ff405cfc5cf398" }
  ]
  // APIトークン等（TOKEN_* / RESEND_API_KEY* / STAFF_PASSWORD）はすべて secret。
  // `wrangler secret put` で管理し、値をこのファイルに書かない（公開リポジトリのため）。
  // STAFF_PASSWORD の元データは ~/.claude/secrets/staff_passwords.json。
}
